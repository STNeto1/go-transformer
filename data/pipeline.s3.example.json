{
  "pipeline_id": "people_filter_s3_v1",
  "version": 1,
  "defaults": {
    "telemetry_format": "json",
    "telemetry_level": "basic"
  },
  "nodes": [
    {
      "id": "src_people",
      "type": "DataSource",
      "config": {
        "format": "csv",
        "path": "s3://inputs/people.csv",
        "mode": "infer",
        "options": {
          "header": true
        }
      }
    },
    {
      "id": "people_filtered",
      "type": "Filter",
      "inputs": ["src_people"],
      "config": {
        "mode": "all",
        "rules": [
          {
            "column": "age",
            "operation": "gt",
            "value": 40
          }
        ]
      }
    }
  ],
  "sinks": [
    {
      "node_id": "people_filtered",
      "target_table": "people_filtered_out",
      "target": {
        "type": "file",
        "format": "parquet",
        "path": "s3://sinks/people_filtered.parquet",
        "mode": "overwrite"
      }
    }
  ]
}
